# Variables of docker-compose.prod.yml. Copy to .env.prod, fill in and start:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --wait
# The guide: docs/deploy.md.

# Required: the password of the database.
POSTGRES_PASSWORD=change-me

# Required: the secret key of the storage of images (the service s3), e.g. `openssl rand -hex 32`; at least 8 characters.
CODRAW_S3_SECRET_KEY=change-me
# CODRAW_S3_ACCESS_KEY=codraw

# Required: the secret of the internal API that collab calls on backend, e.g. `openssl rand -hex 32`.
CODRAW_INTERNAL_TOKEN=change-me

# Required: the RSA key that signs sync tokens, PEM (PKCS#8), with its line breaks:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out collab-signing-key.pem
# and CODRAW_COLLAB_TOKEN_SIGNING_KEY="$(cat collab-signing-key.pem)" in the environment of `docker compose`, or the
# key in double quotes here. When changing the key, keep the previous one for at least 5 minutes.
CODRAW_COLLAB_TOKEN_SIGNING_KEY=
# CODRAW_COLLAB_TOKEN_PREVIOUS_SIGNING_KEY=

# Sign-in through GitHub and Google (README.md, «Вход через GitHub и Google»). The callback URL is
# https://<domain>/api/login/oauth2/code/github and …/google. Without them only the guest sign-in works.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required before an open launch: who provides the service and where users write about their data. The privacy
# policy (/privacy) and the terms of use (/terms) name them; without them the pages say the operator has not.
CODRAW_LEGAL_OPERATOR=
CODRAW_LEGAL_CONTACT_EMAIL=

# Administrators of the installation (docs/deploy.md, «Администраторы установки»): accounts of GitHub and Google as
# <provider>:<id at the provider>, comma-separated. Only this setting makes administrators; empty means none.
# CODRAW_ADMINS=github:583231,google:109876543210987654321

# Optional: PostgreSQL databases whose schemas users may read through the backend («Подключиться к базе…»), as host
# names, addresses and networks (CIDR), comma-separated. Empty keeps it off. Read «Схема из живой базы» in
# docs/deploy.md before turning it on.
# CODRAW_SCHEMA_IMPORT_ALLOWED_HOSTS=db.internal,10.20.0.0/16

# Optional: notifications on email and in chats (docs/deploy.md, «Уведомления на почту и в чат»). Links of letters and
# messages lead to the address of the app; letters need an SMTP server and a sender; chats take incoming webhooks of
# the hosts listed (empty turns chats off).
# CODRAW_APP_URL=https://codraw.example.com
# CODRAW_SMTP_HOST=smtp.example.com
# CODRAW_SMTP_PORT=587
# CODRAW_SMTP_USERNAME=codraw@example.com
# CODRAW_SMTP_PASSWORD=
# CODRAW_MAIL_FROM="CoDraw <codraw@example.com>"
# CODRAW_WEBHOOK_ALLOWED_HOSTS=hooks.slack.com,mattermost.example.com

# Optional: issues of GitHub linked to elements and threads (docs/deploy.md, «Задачи GitHub»). Users connect GitHub with
# tokens of their own. The API of GitHub Enterprise Server instead of github.com, or empty to turn issues off; the
# secret of the webhook of issues that brings their changes at once.
# CODRAW_ISSUES_GITHUB_API_URL=https://github.example.com/api/v3
# CODRAW_ISSUES_GITHUB_WEBHOOK_SECRET=

# The port of the app on the host; the TLS proxy sends requests to it.
CODRAW_HTTP_PORT=8080

# Images: the registry and the tag, e.g. the commit to roll back to.
# CODRAW_IMAGE_PREFIX=ghcr.io/thescarletarrow/codraw-
# CODRAW_VERSION=latest

# The database and its user.
# POSTGRES_DB=codraw
# POSTGRES_USER=codraw

# Another S3-compatible storage of images instead of the service s3, e.g. of a cloud: its address, region and bucket,
# with CODRAW_S3_ACCESS_KEY and CODRAW_S3_SECRET_KEY as its keys.
# CODRAW_IMAGES_S3_ENDPOINT=http://s3:9000
# CODRAW_IMAGES_S3_REGION=us-east-1
# CODRAW_IMAGES_S3_BUCKET=codraw-images
