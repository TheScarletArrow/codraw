# Variables of docker-compose.prod.yml. Copy to .env.prod, fill in and start:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --wait
# The guide: docs/deploy.md.

# Required: the password of the database.
POSTGRES_PASSWORD=change-me

# Required: the secret key of the storage of images (the service s3), e.g. `openssl rand -hex 32`; at least 8 characters.
CODRAW_S3_SECRET_KEY=change-me
# CODRAW_S3_ACCESS_KEY=codraw

# Required: the secret of the internal API that collab calls on backend, e.g. `openssl rand -hex 32`.
CODRAW_INTERNAL_TOKEN=change-me

# Required: the RSA key that signs sync tokens, PEM (PKCS#8), with its line breaks:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out collab-signing-key.pem
# and CODRAW_COLLAB_TOKEN_SIGNING_KEY="$(cat collab-signing-key.pem)" in the environment of `docker compose`, or the
# key in double quotes here. When changing the key, keep the previous one for at least 5 minutes.
CODRAW_COLLAB_TOKEN_SIGNING_KEY=
# CODRAW_COLLAB_TOKEN_PREVIOUS_SIGNING_KEY=

# Sign-in through GitHub and Google (README.md, «Вход через GitHub и Google»). The callback URL is
# https://<domain>/api/login/oauth2/code/github and …/google. The login page offers only the providers set up.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: the sign-in through a corporate provider of OpenID Connect, e.g. Keycloak, Entra ID or Okta (docs/deploy.md,
# «Корпоративный вход»). The callback URL is https://<domain>/api/login/oauth2/code/corp.
# CODRAW_OIDC_ISSUER_URI=https://sso.example.com/realms/acme
# CODRAW_OIDC_CLIENT_ID=codraw
# CODRAW_OIDC_CLIENT_SECRET=
# CODRAW_OIDC_NAME=Keycloak компании
# CODRAW_OIDC_ALLOWED_EMAIL_DOMAINS=example.com
# CODRAW_OIDC_ALLOWED_GROUPS=codraw-users
# CODRAW_OIDC_LOGOUT=true
# A closed installation: no guests, and no GITHUB_* and GOOGLE_* above.
# CODRAW_GUESTS_ENABLED=false

# Required before an open launch: who provides the service and where users write about their data. The privacy
# policy (/privacy) and the terms of use (/terms) name them; without them the pages say the operator has not.
CODRAW_LEGAL_OPERATOR=
CODRAW_LEGAL_CONTACT_EMAIL=

# Administrators of the installation (docs/deploy.md, «Администраторы установки»): accounts of GitHub and Google as
# <provider>:<id at the provider>, of a corporate provider as oidc:<issuer>:<sub>, comma-separated. Only this setting
# makes administrators; empty means none.
# CODRAW_ADMINS=github:583231,google:109876543210987654321,oidc:https://sso.example.com/realms/acme:5f2c8a0e

# Optional: PostgreSQL databases whose schemas users may read through the backend («Подключиться к базе…»), as host
# names, addresses and networks (CIDR), comma-separated. Empty keeps it off. Read «Схема из живой базы» in
# docs/deploy.md before turning it on.
# CODRAW_SCHEMA_IMPORT_ALLOWED_HOSTS=db.internal,10.20.0.0/16

# Optional: notifications on email and in chats (docs/deploy.md, «Уведомления на почту и в чат»). Links of letters and
# messages lead to the address of the app; letters need an SMTP server and a sender; chats take incoming webhooks of
# the hosts listed (empty turns chats off).
# CODRAW_APP_URL=https://codraw.example.com
# CODRAW_SMTP_HOST=smtp.example.com
# CODRAW_SMTP_PORT=587
# CODRAW_SMTP_USERNAME=codraw@example.com
# CODRAW_SMTP_PASSWORD=
# CODRAW_MAIL_FROM="CoDraw <codraw@example.com>"
# CODRAW_WEBHOOK_ALLOWED_HOSTS=hooks.slack.com,mattermost.example.com

# Optional: issues of GitHub linked to elements and threads (docs/deploy.md, «Задачи GitHub»). Users connect GitHub with
# tokens of their own. The API of GitHub Enterprise Server instead of github.com, or empty to turn issues off; the
# secret of the webhook of issues that brings their changes at once.
# CODRAW_ISSUES_GITHUB_API_URL=https://github.example.com/api/v3
# CODRAW_ISSUES_GITHUB_WEBHOOK_SECRET=

# Backups (docs/deploy.md, «Резервные копии»): the service backup makes one at the first start and then on the schedule,
# cron in UTC; it keeps the last archive of each of the last days and weeks. Change the alert CodrawBackupMissing with
# the schedule.
# CODRAW_BACKUP_SCHEDULE=0 3 * * *
# CODRAW_BACKUP_KEEP_DAILY=7
# CODRAW_BACKUP_KEEP_WEEKLY=4
# Where the archives are on the server: the volume `backups`, or a directory, e.g. on another disk, owned by UID 70.
# CODRAW_BACKUP_VOLUME=/mnt/backups
# A password encrypts the archives. Keep it outside the server too: without it the backups cannot be restored.
# CODRAW_BACKUP_ENCRYPTION_PASSWORD=
# Strongly advised: an S3-compatible storage outside the server, which gets a copy of every archive. Give it keys of
# its own, which do not open the storage of images.
# CODRAW_BACKUP_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# CODRAW_BACKUP_S3_REGION=eu-central-1
# CODRAW_BACKUP_S3_BUCKET=codraw-backups
# CODRAW_BACKUP_S3_PREFIX=prod
# CODRAW_BACKUP_S3_ACCESS_KEY=
# CODRAW_BACKUP_S3_SECRET_KEY=

# Optional: delivery of the alerts of the profile monitoring (docs/deploy.md, «Оповещения»). Alertmanager sends each
# alert to every channel set here; a channel set in part stops it with the setting to fix. Without any channel alerts
# go nowhere: Prometheus only shows them on its page, and the log of Alertmanager warns about it at each start.
# Telegram: the token of a bot from @BotFather and the chat that the bot is in, negative for groups.
# CODRAW_ALERT_TELEGRAM_BOT_TOKEN=123456789:AAExampleExampleExampleExample
# CODRAW_ALERT_TELEGRAM_CHAT_ID=-1001234567890
# A server of the Bot API of one's own or a proxy, when api.telegram.org is not reachable from the server.
# CODRAW_ALERT_TELEGRAM_API_URL=https://telegram-proxy.example.com
# Email: addresses, comma-separated; letters go through CODRAW_SMTP_* and from CODRAW_MAIL_FROM above, with TLS only
# (STARTTLS on 587, TLS on 465). false is for a relay inside the network without TLS.
# CODRAW_ALERT_EMAIL_TO=ops@example.com,oncall@example.com
# CODRAW_ALERT_SMTP_REQUIRE_TLS=true
# A chat: an incoming webhook of Slack, Mattermost or Rocket.Chat.
# CODRAW_ALERT_CHAT_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
# Strongly advised: the address of an external watchdog, e.g. healthchecks.io or Uptime Kuma, which gets a POST every 5
# minutes and raises the alarm when they stop: when Prometheus, Alertmanager or the whole server is down.
# CODRAW_ALERT_WATCHDOG_URL=https://hc-ping.com/your-uuid
# A configuration of Alertmanager of one's own instead of the variables above: a path in the container, the file
# mounted by docker-compose.override.yml.
# CODRAW_ALERTMANAGER_CONFIG=/etc/codraw/alertmanager.yml
# The ports of Prometheus and Alertmanager on the server itself (127.0.0.1).
# CODRAW_PROMETHEUS_PORT=9090
# CODRAW_ALERTMANAGER_PORT=9093

# The port of the app on the host; the TLS proxy sends requests to it.
CODRAW_HTTP_PORT=8080

# Images: the registry and the tag, e.g. the commit to roll back to.
# CODRAW_IMAGE_PREFIX=ghcr.io/thescarletarrow/codraw-
# CODRAW_VERSION=latest

# The database and its user.
# POSTGRES_DB=codraw
# POSTGRES_USER=codraw

# Another S3-compatible storage of images instead of the service s3, e.g. of a cloud: its address, region and bucket,
# with CODRAW_S3_ACCESS_KEY and CODRAW_S3_SECRET_KEY as its keys.
# CODRAW_IMAGES_S3_ENDPOINT=http://s3:9000
# CODRAW_IMAGES_S3_REGION=us-east-1
# CODRAW_IMAGES_S3_BUCKET=codraw-images

# Milliseconds that changes and cursors of a board gather in collab before they go to its participants together; 0
# sends them at once. 20–30 halve the processor of collab on boards of tens of participants (docs/load-testing.md).
# CODRAW_COLLAB_BROADCAST_DELAY_MS=0
