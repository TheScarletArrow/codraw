{
  "name": "codraw",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:frontend": "pnpm --filter @codraw/frontend dev",
    "dev:collab": "pnpm --filter @codraw/collab dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @codraw/e2e test:e2e"
  }
}
