{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "playwright.config.ts",
    "playwright.stack.config.ts",
    "tests",
    "stack"
  ]
}
