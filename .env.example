# Переменные окружения сервисов CoDraw.
# Для локальной разработки достаточно переменных OAuth-приложений (см. README.md, «Вход через GitHub и Google»):
# остальное docker compose, `./gradlew bootRun` и `pnpm dev:collab` берут из значений по умолчанию.

# PostgreSQL в docker-compose.yml
POSTGRES_DB=codraw
POSTGRES_USER=codraw
POSTGRES_PASSWORD=codraw
POSTGRES_PORT=5432

# Хранилище изображений (S3, RustFS) в docker-compose.yml
S3_ACCESS_KEY=codraw
S3_SECRET_KEY=codraw-secret
S3_PORT=9000

# backend
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/codraw
SPRING_DATASOURCE_USERNAME=codraw
SPRING_DATASOURCE_PASSWORD=codraw

# Хранилище изображений досок; в профиле dev backend берёт эти значения сам.
CODRAW_IMAGES_S3_ENDPOINT=http://localhost:9000
CODRAW_IMAGES_S3_ACCESS_KEY=codraw
CODRAW_IMAGES_S3_SECRET_KEY=codraw-secret

# Общий секрет для внутреннего API backend. Должен совпадать у backend и collab.
CODRAW_INTERNAL_TOKEN=change-me

# OAuth-приложения для входа, см. README.md.
GITHUB_CLIENT_ID=change-me
GITHUB_CLIENT_SECRET=change-me
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# RSA-ключ подписи токенов синхронизации, PEM (PKCS#8), одинаковый у всех экземпляров backend:
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out collab-signing-key.pem
# Без него backend генерирует ключ при старте. Предыдущий ключ задаётся на время смены ключа.
# CODRAW_COLLAB_TOKEN_SIGNING_KEY=
# CODRAW_COLLAB_TOKEN_PREVIOUS_SIGNING_KEY=

# Базы PostgreSQL, схему которых можно загрузить через backend («Подключиться к базе…»): имена, адреса и сети CIDR
# через запятую. Пусто — выключено. Например, база из docker-compose.yml: localhost.
# CODRAW_SCHEMA_IMPORT_ALLOWED_HOSTS=localhost

# Уведомления на почту и в чат (docs/deploy.md): адрес приложения для ссылок (в профиле dev — http://localhost:5173),
# SMTP-сервер и отправитель писем, хосты входящих вебхуков чатов. Без хоста SMTP писем нет. Для проверки писем локально
# подойдёт Mailpit: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit, письма — на http://localhost:8025.
# CODRAW_NOTIFICATIONS_APP_URL=http://localhost:5173
# SPRING_MAIL_HOST=localhost
# SPRING_MAIL_PORT=1025
# CODRAW_NOTIFICATIONS_EMAIL_FROM=CoDraw <codraw@localhost>
# CODRAW_NOTIFICATIONS_WEBHOOK_ALLOWED_HOSTS=hooks.slack.com

# collab
BACKEND_URL=http://localhost:8080
BACKEND_JWKS_URL=http://localhost:8080/.well-known/jwks.json
PORT=1234
